# Socket.io server URL for real-time communication
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# API endpoint for backend communication
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Feature flags
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_FILE_UPLOAD=true
NEXT_PUBLIC_ENABLE_WEB_SEARCH=true
NEXT_PUBLIC_ENABLE_PROMPT_ENHANCER=true

# OpenAI API configuration (for web search)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Cookie and privacy settings
NEXT_PUBLIC_COOKIE_DOMAIN=localhost
NEXT_PUBLIC_COOKIE_SECURE=false
NEXT_PUBLIC_COOKIE_SAMESITE=lax

# Internationalization
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,hi,de,ru

# Analytics (optional)
NEXT_PUBLIC_GA_TRACKING_ID=your_ga_tracking_id
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Development settings
NODE_ENV=development
NEXT_PUBLIC_DEBUG=true